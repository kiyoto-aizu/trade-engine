# Slack Incoming Webhooks
SLACK_WEBHOOK_CRITICAL=
SLACK_WEBHOOK_DAILY=
SLACK_WEBHOOK_ANALYSIS=

# 公開用日次レポート（専用fine-grained PAT。対象リポジトリはkiyoto-aizu/trade-reportだけに限定）
TRADE_REPORT_PUBLISH_ENABLED=false
TRADE_REPORT_GITHUB_TOKEN=
TRADE_REPORT_REPOSITORY=kiyoto-aizu/trade-report
TRADE_REPORT_PUBLIC_URL=https://kiyoto-aizu.github.io/trade-report/
# Pages反映待ち: 最大12回、10秒間隔
TRADE_REPORT_PUBLISH_RETRY_COUNT=12
TRADE_REPORT_PUBLISH_RETRY_WAIT_SECONDS=10
TRADE_REPORT_PUBLISH_CONDITION_DETAILS=true

# kabusapi settings
API_PORT_DEV=
API_PASSWORD_DEV=
API_PORT_PRD=
API_PASSWORD_PRD=

# J-Quants API（接続確認スクリプト用）
JQUANTS_API_KEY=

# Issue作成ドライラン疎通確認スクリプト用
ISSUE_CREATION_WEBHOOK_SECRET=

# 実行モード（true: デモ環境 / false: 本番環境）
IS_DEMO=true
# 本番モード(IS_DEMO=false)で実取引を許可する場合のみtrue
ENABLE_LIVE_ORDERING=false

# キルスイッチ・資金管理設定
# スクリーニングのランキング取得対象とする市場区分（カンマ区切り、/rankingのExchangeDivision）
# 例: TP=東証プライム, TS=東証スタンダード, TG=グロース250
SCREENING_EXCHANGE_DIVISIONS=TP,TS,TG
# 取引に利用可能な運用資本（円）
OPERATING_CAPITAL=100000
# 1回の取引あたりの最大注文金額（円）
MAX_ORDER_AMOUNT_PER_TRADE=30000
# スクリーニング時の株価上限に掛ける安全マージン
SCREENING_PRICE_MARGIN=0.9
# ADR-0001: 値上がり率ランキング側の重み(1.0=従来通りの等重み)。要データ検証・調整。
PRICE_GAIN_WEIGHT=1.0
# 1日あたりの最大注文数
MAX_ORDER_COUNT_PER_DAY=10
# 1日の損失限度額（運用資本の比率、例：0.02 = 2%）
DAILY_LOSS_LIMIT_RATIO=0.02
# APIソフトリミット（kabu APIの現物ワンショット上限、円）
API_SOFT_LIMIT=1000000
# kabuステーションAPIの最小呼出間隔（秒）
API_REQUEST_INTERVAL_SECONDS=0.12

# ================================================================================
# LLM分析設定（すべて明示的にtrueにするまで無効。OPENAI_API_KEYは各機能で共用）
# ================================================================================
# OpenAI Platformで発行したAPIキー（キーは共有・コミットしないでください）
OPENAI_API_KEY=
# 使用するモデル（既定: gpt-4o-mini）
LLM_MODEL=
# OpenAI以外の互換APIを使う場合のみ設定（既定: OpenAIのchat/completions）
LLM_API_URL=

# 日次/バックテスト/月次レポートをLLMで評価し、Slack通知に参考意見として追記する
LLM_DAILY_ANALYSIS_ENABLED=false

# 未処理例外の原因をLLMで分析する。同一原因はキャッシュを再利用し、クールダウン間隔でのみ再分析する
LLM_ERROR_ANALYSIS_ENABLED=false
# 再分析までのクールダウン（分、既定60）
LLM_ERROR_ANALYSIS_COOLDOWN_MINUTES=
# 例外分析専用のモデル（未設定時はLLM_MODELを使用）
LLM_ERROR_ANALYSIS_MODEL=
# リトライで解決しうる例外はLLM分析の対象外にする（カンマ区切りのクラス名）
LLM_ERROR_ANALYSIS_SKIP_EXCEPTION_TYPES=

# スクリーニング/フィルタリングの採用件数が閾値未満のときだけLLMで異常検知コメントを生成する
LLM_ANOMALY_ANALYSIS_ENABLED=false
# 採用件数がこの値未満のときにLLMを呼び出す（既定: スクリーニング5、フィルタリング3）
SCREENING_ANOMALY_MIN_SYMBOLS=
FILTERING_ANOMALY_MIN_SYMBOLS=
